    "Confidence": {
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "title": "Confidence",
      "type": "string"
    },
    "Contact": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "confidence": {
          "$ref": "#/$defs/Confidence"
        },
        "last_verified": {
          "format": "date",
          "title": "Last Verified",
          "type": "string"
        },
        "type": {
          "const": "contact",
          "default": "contact",
          "title": "Type",
          "type": "string"
        },
        "role": {
          "title": "Role",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "phone": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Phone"
        },
        "is_sample": {
          "default": true,
          "title": "Is Sample",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "summary",
        "source",
        "confidence",
        "last_verified",
        "role",
        "name"
      ],
      "title": "Contact",
      "type": "object"
    },
    "CostNote": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "confidence": {
          "$ref": "#/$defs/Confidence"
        },
        "last_verified": {
          "format": "date",
          "title": "Last Verified",
          "type": "string"
        },
        "type": {
          "const": "cost_note",
          "default": "cost_note",
