        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "confidence": {
          "$ref": "#/$defs/Confidence"
        },
        "last_verified": {
          "format": "date",
          "title": "Last Verified",
          "type": "string"
        },
        "type": {
          "const": "site_fact",
          "default": "site_fact",
          "title": "Type",
          "type": "string"
        },
        "topic": {
          "title": "Topic",
          "type": "string"
        }
