        "item": {
          "title": "Item",
          "type": "string"
        },
        "amount_ngn_min": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Amount Ngn Min"
        },
        "amount_ngn_max": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Amount Ngn Max"
        }
      },
      "required": [
        "id",
        "summary",
        "source",
        "confidence",
        "last_verified",
        "item"
      ],
      "title": "CostNote",
      "type": "object"
    },
    "RoadNote": {
      "additionalProperties": false,
