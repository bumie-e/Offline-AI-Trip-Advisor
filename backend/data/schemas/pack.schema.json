      "additionalProperties": false,
      "properties": {
        "publisher": {
          "title": "Publisher",
          "type": "string"
        },
        "url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Url",
          "type": "string"
        },
        "published": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Published"
        }
      },
      "required": [
        "publisher",
        "url"
      ],
      "title": "Source",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Downloaded once on Wi-Fi. Changes rarely.",
  "properties": {
    "site_id": {
      "title": "Site Id",
      "type": "string"
    },
    "version": {
      "title": "Version",
      "type": "string"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "records": {
      "items": {
        "discriminator": {
          "mapping": {
            "contact": "#/$defs/Contact",
            "cost_note": "#/$defs/CostNote",
            "road_note": "#/$defs/RoadNote",
            "site_fact": "#/$defs/SiteFact"
          },
          "propertyName": "type"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/RoadNote"
          },
          {
            "$ref": "#/$defs/SiteFact"
          },
          {
            "$ref": "#/$defs/CostNote"
          },
          {
            "$ref": "#/$defs/Contact"
          }
        ]
      },
      "title": "Records",
      "type": "array"
    }
  },
  "required": [
    "site_id",
    "version",
    "generated_at",
    "records"
  ],
  "title": "Pack",
  "type": "object"
}
