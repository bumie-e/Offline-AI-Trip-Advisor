{
  "$defs": {
    "Advice": {
      "additionalProperties": false,
      "description": "Structured model output, also produced on-device. Checked by guardrails.",
      "properties": {
        "changed": {
          "title": "Changed",
          "type": "boolean"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "advice": {
          "title": "Advice",
          "type": "string"
        },
        "alternatives": {
          "items": {
            "type": "string"
          },
          "title": "Alternatives",
          "type": "array"
        },
        "cited_ids": {
          "items": {
            "type": "string"
          },
          "title": "Cited Ids",
          "type": "array"
        }
      },
      "required": [
        "changed",
        "severity",
        "advice",
        "cited_ids"
      ],
      "title": "Advice",
      "type": "object"
    },
    "Confidence": {
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "title": "Confidence",
      "type": "string"
    },
    "Severity": {
      "enum": [
        "none",
        "elevated",
        "high"
      ],
      "title": "Severity",
      "type": "string"
    },
    "Stop": {
      "additionalProperties": false,
      "properties": {
        "order": {
          "minimum": 1,
          "title": "Order",
          "type": "integer"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "mode": {
          "anyOf": [
            {
              "$ref": "#/$defs/TravelMode"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "duration_minutes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Minutes"
        },
        "notes": {
          "default": "",
          "title": "Notes",
          "type": "string"
        },
        "cited_ids": {
          "items": {
            "type": "string"
          },
          "title": "Cited Ids",
          "type": "array"
        },
        "comment": {
          "default": "",
          "title": "Comment",
          "type": "string"
        },
        "image": {
          "anyOf": [
            {
              "$ref": "#/$defs/StopImage"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "road": {
          "anyOf": [
            {
              "$ref": "#/$defs/StopRoad"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "advice": {
          "default": "",
          "title": "Advice",
          "type": "string"
        }
      },
      "required": [
        "order",
        "title"
      ],
      "title": "Stop",
      "type": "object"
    },
    "StopImage": {
      "additionalProperties": false,
      "description": "The one photo shown for a stop. The file is fetched from `path`.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "caption": {
          "title": "Caption",
          "type": "string"
        },
        "credit": {
          "title": "Credit",
          "type": "string"
        },
        "license": {
          "title": "License",
          "type": "string"
        },
        "width": {
          "minimum": 1,
          "title": "Width",
          "type": "integer"
        },
        "height": {
          "minimum": 1,
          "title": "Height",
          "type": "integer"
        },
        "shows_this_stop": {
          "default": true,
          "title": "Shows This Stop",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "path",
        "caption",
        "credit",
        "license",
        "width",
        "height"
      ],
      "title": "StopImage",
      "type": "object"
    },
    "StopRoad": {
      "additionalProperties": false,
      "description": "What a traveller sees on tapping a stop: the nature of the road there.",
      "properties": {
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "km_from_start": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Km From Start"
        },
        "km_since_previous_stop": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Km Since Previous Stop"
        },
        "condition": {
          "default": "",
          "title": "Condition",
          "type": "string"
        },
        "has_recent_report": {
          "default": false,
          "title": "Has Recent Report",
          "type": "boolean"
        },
        "scope": {
          "anyOf": [
            {
              "enum": [
                "here",
                "road",
                "corridor"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scope"
        },
        "confidence": {
          "anyOf": [
            {
              "$ref": "#/$defs/Confidence"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "report_age_days": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Report Age Days"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "title": "StopRoad",
      "type": "object"
    },
    "TravelMode": {
      "enum": [
        "road",
        "train",
        "flight",
        "walk"
      ],
      "title": "TravelMode",
      "type": "string"
    },
    "TripRequest": {
      "additionalProperties": false,
      "description": "Stage 2, 'Plan my visit'.",
      "properties": {
        "site_id": {
          "title": "Site Id",
          "type": "string"
        },
        "start_city": {
          "title": "Start City",
          "type": "string"
        },
        "arrival_airport": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Arrival Airport"
        },
        "start_date": {
          "format": "date",
          "title": "Start Date",
          "type": "string"
        },
        "end_date": {
          "format": "date",
          "title": "End Date",
          "type": "string"
        },
        "group_size": {
          "maximum": 50,
          "minimum": 1,
          "title": "Group Size",
          "type": "integer"
        },
        "budget_ngn": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Budget Ngn"
        },
        "mode": {
          "anyOf": [
            {
              "$ref": "#/$defs/TravelMode"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "site_id",
        "start_city",
        "start_date",
        "end_date",
        "group_size"
      ],
      "title": "TripRequest",
      "type": "object"
    },
    "Verdict": {
      "enum": [
        "go",
        "go_with_changes",
        "not_advised"
      ],
      "title": "Verdict",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "site_id": {
      "title": "Site Id",
      "type": "string"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "request": {
      "$ref": "#/$defs/TripRequest"
    },
    "verdict": {
      "$ref": "#/$defs/Verdict"
    },
    "summary": {
      "default": "",
      "title": "Summary",
      "type": "string"
    },
    "verdict_reasons": {
      "items": {
        "$ref": "#/$defs/Advice"
      },
      "title": "Verdict Reasons",
      "type": "array"
    },
    "stops": {
      "items": {
        "$ref": "#/$defs/Stop"
      },
      "title": "Stops",
      "type": "array"
    },
    "return_leg": {
      "items": {
        "$ref": "#/$defs/Stop"
      },
      "title": "Return Leg",
      "type": "array"
    }
  },
  "required": [
    "site_id",
    "generated_at",
    "request",
    "verdict",
    "verdict_reasons",
    "stops"
  ],
  "title": "Itinerary",
  "type": "object"
}
